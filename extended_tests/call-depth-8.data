#
# Chain of exactly 8 nested calls (counting from 1): main -> f1 -> f2 -> f3 -> f4 -> f5 -> f6 -> f7
# This should pass on our vm, but fail on linux (libbpf_plugin).
# The failure on linux is due to libbpf_plugin uses an additional local call into the test program
# for collecting final result, therefore the actually program loaded into the kernel has call depth
# +1.

-- asm
call local f1
# on return, r0 should be 1
jne %r0, 1, failed
mov %r0, 1
exit

failed:
mov %r0, -1
exit

f1:
call local f2
exit

f2:
call local f3
exit

f3:
call local f4
exit

f4:
call local f5
exit

f5:
call local f6
exit

f6:
call local f7
exit

f7:
mov %r0, 1
exit
-- result
0x1
