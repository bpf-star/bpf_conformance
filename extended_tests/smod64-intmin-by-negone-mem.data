#
# INT64_MIN s% -1 = 0, with both operands loaded from memory so a JIT cannot
# constant-fold the operation (x86 idiv traps on this input).

-- asm
ldxdw %r0, [%r1]
ldxdw %r2, [%r1+8]
smod %r0, %r2
exit
-- mem
00 00 00 00 00 00 00 80 ff ff ff ff ff ff ff ff
-- result
0x0
